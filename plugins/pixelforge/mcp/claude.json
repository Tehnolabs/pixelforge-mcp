{
  "mcpServers": {
    "pixelforge": {
      "command": "uvx",
      "args": [
        "pixelforge-mcp@latest"
      ],
      "env": {
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY:-${user_config.google_api_key}}",
        "GOOGLE_CLOUD_PROJECT": "${GOOGLE_CLOUD_PROJECT:-${user_config.google_cloud_project}}",
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-${user_config.google_application_credentials}}"
      }
    }
  }
}
